rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(resourceData) {
      return signedIn() && resourceData.createdBy == request.auth.uid;
    }

    match /tags/{tagId} {
      allow read: if true;
      allow create: if signedIn();
      allow update: if isAdmin() || isOwner(resource.data);
      allow delete: if isAdmin() || isOwner(resource.data);
    }

    match /trash/{trashId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() && request.resource.data.trashedBy == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
