rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(resourceData) {
      return signedIn() && resourceData.createdBy == request.auth.uid;
    }

    function allowedSourceType(value) {
      return value == null || value in ["manual", "official", "marketplace", "archive", "resale", "unknown"];
    }

    function allowedVerificationStatus(value) {
      return value == null || value in ["draft", "needs_info", "pending", "reviewed", "verified", "rejected"];
    }

    function stringOrNull(value, maxLen) {
      return value == null || (value is string && value.size() <= maxLen);
    }

    // Note: this only checks the list's shape (type + item count), not each
    // element's type/length -- the rules language has no loop/lambda
    // construct for validating arbitrary-length lists item-by-item.
    function stringListOrNull(value, maxItems) {
      return value == null || (value is list && value.size() <= maxItems);
    }

    function validTagKeys(data) {
      return data.keys().hasOnly([
        'brand', 'productName', 'rn', 'styleNumber', 'garmentType', 'size', 'availableSizes', 'tags', 'category', 'subCategory', 'gender', 'year', 'season',
        'madeIn', 'materials', 'careText', 'color', 'notes', 'imageUrl', 'thumbnailUrl', 'extraImageUrls', 'sourceUrl', 'sourceName', 'sourceType',
        'confidence', 'verificationStatus', 'searchText', 'storagePath', 'createdBy', 'createdAt', 'importedAt'
      ]);
    }

    function validTagData(data) {
      // Dot access on a genuinely missing map key (as opposed to a key set
      // to null) throws an evaluation error in this rules language, unlike
      // JS -- so every optional field is read through .get(key, null)
      // rather than data.key, to tolerate callers that omit rather than
      // null out unused fields.
      return validTagKeys(data) &&
        stringOrNull(data.get('brand', null), 120) &&
        stringOrNull(data.get('productName', null), 200) &&
        stringOrNull(data.get('rn', null), 7) &&
        stringOrNull(data.get('styleNumber', null), 120) &&
        stringOrNull(data.get('garmentType', null), 120) &&
        stringOrNull(data.get('size', null), 60) &&
        stringListOrNull(data.get('availableSizes', null), 20) &&
        stringListOrNull(data.get('tags', null), 25) &&
        stringOrNull(data.get('category', null), 120) &&
        stringOrNull(data.get('subCategory', null), 120) &&
        stringOrNull(data.get('gender', null), 60) &&
        stringOrNull(data.get('year', null), 40) &&
        stringOrNull(data.get('season', null), 80) &&
        stringOrNull(data.get('madeIn', null), 120) &&
        stringOrNull(data.get('materials', null), 1000) &&
        stringOrNull(data.get('careText', null), 4000) &&
        stringOrNull(data.get('color', null), 120) &&
        stringOrNull(data.get('notes', null), 4000) &&
        data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 2048 &&
        stringOrNull(data.get('thumbnailUrl', null), 2048) &&
        stringListOrNull(data.get('extraImageUrls', null), 8) &&
        stringOrNull(data.get('sourceUrl', null), 2048) &&
        stringOrNull(data.get('sourceName', null), 255) &&
        allowedSourceType(data.get('sourceType', null)) &&
        allowedVerificationStatus(data.get('verificationStatus', null)) &&
        stringOrNull(data.get('searchText', null), 20000) &&
        stringOrNull(data.get('storagePath', null), 1024) &&
        stringOrNull(data.get('createdBy', null), 128) &&
        stringOrNull(data.get('importedAt', null), 80) &&
        (data.get('confidence', null) == null || (data.confidence is number && data.confidence >= 0 && data.confidence <= 1));
    }

    match /tags/{tagId} {
      allow read: if true;
      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        validTagData(request.resource.data);
      // Not enforcing validTagData on update: existing documents written
      // before this check existed aren't guaranteed to conform, and doing
      // so could block legitimate edits to those records until a data
      // cleanup pass confirms they all validate.
      allow update: if (isAdmin() || isOwner(resource.data)) &&
        request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin() || isOwner(resource.data);
    }

    match /trash/{trashId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    function validSearchMissData(data) {
      return data.keys().hasOnly(['query', 'normalizedQuery', 'count', 'firstSearchedAt', 'lastSearchedAt']) &&
        data.query is string && data.query.size() <= 200 &&
        data.normalizedQuery is string && data.normalizedQuery.size() <= 200 &&
        data.count is number && data.count >= 1 && data.count <= 1000000;
    }

    match /search_misses/{missId} {
      allow read: if isAdmin();
      allow create, update: if signedIn() && validSearchMissData(request.resource.data);
      allow delete: if isAdmin();
    }

    match /imports_review/{importId} {
      allow read: if isAdmin() || isOwner(resource.data);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin() || isOwner(resource.data);
    }

    match /admins/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /submissions/{submissionId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }
  }
}
