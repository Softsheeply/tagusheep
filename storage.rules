rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    match /tagusheep/uploads/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    match /tagusheep/imports/{uid}/{allPaths=**} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid || isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
