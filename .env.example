# Firebase (public web configuration; not service-account secrets)
NEXT_PUBLIC_FB_API_KEY=
NEXT_PUBLIC_FB_AUTH_DOMAIN=
NEXT_PUBLIC_FB_PROJECT_ID=
NEXT_PUBLIC_FB_STORAGE_BUCKET=
NEXT_PUBLIC_FB_APP_ID=

# Optional public site URL (used for sitemap/metadata). Falls back to VERCEL_URL.
NEXT_PUBLIC_SITE_URL=https://tagsheep.com

# Cloudflare Images (server-only credentials + public delivery hash)
# When unset, uploads automatically fall back to Firebase Storage.
CF_ACCOUNT_ID=
CF_IMAGES_API_TOKEN=
# Account hash from Cloudflare Images → Developer Resources (also used client-side for docs).
CF_IMAGES_ACCOUNT_HASH=
NEXT_PUBLIC_CF_IMAGES_HASH=

# Optional: Firebase App Check / Sentry (no-op until set)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Bulk importer account
TAGSHEEP_IMPORT_EMAIL=
TAGSHEEP_IMPORT_PASSWORD=
