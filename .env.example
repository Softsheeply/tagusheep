# Firebase (public web configuration; not service-account secrets)
NEXT_PUBLIC_FB_API_KEY=
NEXT_PUBLIC_FB_AUTH_DOMAIN=
NEXT_PUBLIC_FB_PROJECT_ID=
NEXT_PUBLIC_FB_APP_ID=

# Cloudflare R2 (server-only credentials)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tagusheep-images

# Public custom domain attached to the R2 bucket, without a trailing slash.
# Use a production custom domain such as https://images.tagsheep.com rather
# than the rate-limited r2.dev URL.
NEXT_PUBLIC_R2_PUBLIC_URL=https://images.tagsheep.com

# Bulk importer account
TAGSHEEP_IMPORT_EMAIL=
TAGSHEEP_IMPORT_PASSWORD=
